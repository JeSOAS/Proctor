{
  "manifest_version": 3,
  "name": "Proctor — Exam Monitoring (Dev)",
  "version": "0.1.0",
  "description": "Prototype Chrome extension that logs student-side events to console for development.",
  "permissions": [
    "tabs",
    "windows",
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Proctor"
  }
}

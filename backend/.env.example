# Backend environment. Copy to backend/.env for running the backend directly
# with `npm run start:dev` (outside Docker). Inside Docker Compose these values
# come from docker/.env instead — see docker/.env.example.

# PostgreSQL connection. Point this at a Postgres you can reach: the Compose DB,
# a local Postgres, or a hosted one. (No more SQLite — see schema.prisma.)
DATABASE_URL="postgresql://proctor:proctor@localhost:5432/proctor?schema=public"

# Shared secret for instructor/destructive endpoints. If unset, those endpoints
# are OPEN (fine for local dev). MUST be set in production.
ADMIN_TOKEN=

PORT=3000

# Local development: file-based SQLite, no installation needed.
# The file is created at backend/prisma/dev.db on first migration.
DATABASE_URL="file:./dev.db"

# Production (Linux VM): switch schema.prisma provider to "postgresql",
# start docker/docker-compose.yml and use:
# DATABASE_URL="postgresql://proctor:proctor@localhost:5432/proctor?schema=public"
# REDIS_URL="redis://localhost:6379"

PORT=3000

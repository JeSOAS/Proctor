// Prisma schema — intentionally minimal for Week 2.
// Real models (Session, Student, Violation, Instructor, ExamConfig) will be
// added in Week 3+ once the data flow is decided.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Placeholder so `prisma migrate dev` succeeds.
/// Replace with real models once schema design is finalised.
model HealthCheck {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
}

// PostgreSQL — used both in production (Oracle VM, via docker/docker-compose.yml)
// and for local development (run the same compose, or point DATABASE_URL at any
// Postgres). We moved off SQLite because a real exam has ~dozens of students
// writing events concurrently, which triggers SQLite write-lock errors.
//
// Models intentionally use plain String for `status`/`type`/`payload` rather
// than Postgres enums / Json. That kept the switch from SQLite a zero-code-change
// port; the next team may tighten these to enums + Json (see docs/DECISIONS.md).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// An instructor account. Owns courses; the dashboard scopes everything to the
/// logged-in teacher so teachers only ever see their own data.
model Teacher {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
  courses      Course[]
}

/// A course a teacher runs, identified by year + name + section (all free-text).
model Course {
  id        String   @id @default(cuid())
  name      String
  year      String?
  section   String?
  teacher   Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  teacherId String
  createdAt DateTime @default(now())
  exams     Exam[]

  @@index([teacherId])
}

/// An exam session created by an instructor. `joinCode` is the short token a
/// student enters (later: embedded in a link/QR) to register into this exam.
/// `courseId` is nullable at the DB level for migration safety, but the API
/// always requires a course (which establishes teacher ownership).
model Exam {
  id          String           @id @default(cuid())
  title       String
  joinCode    String           @unique
  status      String           @default("OPEN") // DRAFT | OPEN | CLOSED
  maxWarnings Int              @default(3)
  startsAt    DateTime? // scheduled/planned start
  endsAt      DateTime? // if set, the exam auto-closes at this time (the "timer")
  openedAt    DateTime? // when it actually became OPEN (created / reopened)
  closedAt    DateTime? // when it actually closed
  createdAt   DateTime         @default(now())
  course      Course?          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId    String?
  sessions    StudentSession[]

  @@index([courseId])
}

/// One student's participation in an exam. Created when the student registers
/// with a join code; owns all monitoring events for that student.
model StudentSession {
  id          String      @id @default(cuid())
  exam        Exam        @relation(fields: [examId], references: [id], onDelete: Cascade)
  examId      String
  studentName String
  studentId   String? // optional university/student number
  status         String   @default("ACTIVE") // ACTIVE | DISCONNECTED | ENDED
  startedAt      DateTime @default(now())
  endedAt        DateTime?
  endedReason    String? // LEFT (pressed Leave) | TIMEOUT (disconnected too long)
  /// Set when heartbeats stop (status DISCONNECTED). Cleared when the session
  /// resumes. If it stays DISCONNECTED past the resume window, it becomes ENDED.
  disconnectedAt DateTime?
  /// Bumped by every heartbeat/violation. ACTIVE sessions whose lastSeenAt is
  /// older than the stale timeout are marked DISCONNECTED (heartbeats stopped —
  /// MV3 workers die without a shutdown event, so we can't report it directly).
  lastSeenAt     DateTime @default(now())
  userAgent   String?
  violations  Violation[]

  @@index([examId])
}

/// A monitoring event reported by the extension (tab switch, focus loss,
/// clipboard use, ...). `type` is a free string so new event types don't
/// require a migration; `payload` holds type-specific details as JSON text.
model Violation {
  id         Int            @id @default(autoincrement())
  session    StudentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId  String
  type       String
  url        String?
  payload    String?
  occurredAt DateTime       @default(now())

  @@index([sessionId, occurredAt])
}

# Copy to docker/.env and fill in strong values. docker/.env is gitignored.
# Generate secrets with, e.g.:  openssl rand -hex 24

# Postgres credentials (the DB is not exposed publicly, but still use a strong password)
POSTGRES_USER=proctor
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=proctor

# Admin secret — creates teacher accounts (POST /auth/register) and the dev wipe.
# Send it as the `x-admin-token` header. Keep it private.
ADMIN_TOKEN=CHANGE_ME_long_random_admin_token

# Secret used to sign teacher login tokens (JWT). Use a long random value.
JWT_SECRET=CHANGE_ME_long_random_jwt_secret

# Cloudflare Tunnel token — Zero Trust → Networks → Tunnels → your tunnel →
# "Install connector" → the long string after `--token`. Only needed on the VM
# when starting with the "tunnel" profile.
TUNNEL_TOKEN=
